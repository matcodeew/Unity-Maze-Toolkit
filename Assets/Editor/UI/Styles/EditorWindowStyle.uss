:root {
}

.header {
    background-color: rgb(156, 221, 210);
}

.titleLabel {
    font-size: 57px;
    -unity-text-align: upper-center;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}



.textField {
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-right;
    left: -64px;
    font-size: 14px;
    margin-top: 5px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.button {
    border-left-color: rgba(172, 252, 255, 0.455);
    border-right-color: rgba(172, 252, 255, 0.455);
    border-top-color: rgba(172, 252, 255, 0.455);
    border-bottom-color: rgba(172, 252, 255, 0.455);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 15px;
    text-shadow: 5px 5px 0 rgb(51, 51, 51);
}
